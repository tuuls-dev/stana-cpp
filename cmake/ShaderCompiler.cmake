# Immutable source/dependency hashes are in tools/bootstrap_tint.py. No fetching here.
set(STANA_TINT_REVISION "cb91d23e247042a2a5490c27d9b06300db91afef")
set(_stana_tint_suffix "")
if(NOT STANA_SANITIZER STREQUAL "")
    set(_stana_tint_suffix "-${STANA_SANITIZER}")
endif()
set(STANA_TINT_ROOT "${PROJECT_SOURCE_DIR}/.tools/tint${_stana_tint_suffix}" CACHE PATH "Provisioned private Tint compiler")
if(NOT EXISTS "${STANA_TINT_ROOT}/stana-tint.json")
    message(FATAL_ERROR "Provision private Tint first: python3 tools/bootstrap_tint.py --compiler ${CMAKE_CXX_COMPILER} --sanitizer=${STANA_SANITIZER}")
endif()
file(READ "${STANA_TINT_ROOT}/stana-tint.json" _stana_tint_manifest)
string(JSON _stana_tint_revision GET "${_stana_tint_manifest}" revision)
string(JSON _stana_tint_sanitizer GET "${_stana_tint_manifest}" sanitizer)
if(NOT _stana_tint_revision STREQUAL STANA_TINT_REVISION OR NOT _stana_tint_sanitizer STREQUAL STANA_SANITIZER)
    message(FATAL_ERROR "Tint revision/instrumentation does not match Stana")
endif()
if(WIN32)
    set(_stana_tint_archive stana-tint.lib)
else()
    set(_stana_tint_archive libstana-tint.a)
endif()
add_library(stana::tint STATIC IMPORTED GLOBAL)
set_target_properties(stana::tint PROPERTIES IMPORTED_LOCATION "${STANA_TINT_ROOT}/lib/${_stana_tint_archive}")
if(STANA_SANITIZER STREQUAL "")
    install(FILES "${STANA_TINT_ROOT}/lib/${_stana_tint_archive}" DESTINATION "${CMAKE_INSTALL_LIBDIR}")
    install(FILES "${STANA_TINT_ROOT}/stana-tint.json" DESTINATION "${CMAKE_INSTALL_DATADIR}/stana")
    install(DIRECTORY "${STANA_TINT_ROOT}/licenses/" DESTINATION "${CMAKE_INSTALL_DATADIR}/stana/licenses/tint")
    configure_file("${PROJECT_SOURCE_DIR}/cmake/stanaTint.cmake.in" "${PROJECT_BINARY_DIR}/stanaTint.cmake" @ONLY)
    install(FILES "${PROJECT_BINARY_DIR}/stanaTint.cmake" DESTINATION "${CMAKE_INSTALL_LIBDIR}/cmake/stana")
endif()
