InheritParentConfig: false
Checks: >-
  -*,
  clang-analyzer-*,
  bugprone-*,
  cert-*,
  concurrency-*,
  cppcoreguidelines-*,
  modernize-*,
  performance-*,
  portability-*,
  misc-const-correctness,
  misc-unused-parameters,
  readability-braces-around-statements,
  readability-implicit-bool-conversion,
  custom-*
WarningsAsErrors: "*"
HeaderFilterRegex: ".*"
SystemHeaders: false
CheckOptions:
  modernize-use-nodiscard.ReplacementString: "[[nodiscard]]"
  modernize-avoid-c-arrays.AllowStringArrays: false
  cppcoreguidelines-pro-bounds-avoid-unchecked-container-access.FixMode: at
CustomChecks:
  - Name: no-unsafe-c-api
    Query: |
      match callExpr(callee(functionDecl(hasAnyName("strcpy", "strcat", "strncpy", "strncat", "sprintf", "vsprintf", "gets", "memcpy", "memmove", "memset"))), unless(isExpansionInSystemHeader())).bind("bad")
    Diagnostic:
      - BindName: bad
        Message: "Unsafe legacy buffer APIs are forbidden; use containers, ranges and std::format."
        Level: Warning
  - Name: no-raw-allocation
    Query: |
      match expr(anyOf(cxxNewExpr(), cxxDeleteExpr()), unless(isExpansionInSystemHeader())).bind("bad")
    Diagnostic:
      - BindName: bad
        Message: "Explicit new/delete is forbidden; use RAII factories and containers."
        Level: Warning
  - Name: no-c-style-cast
    Query: |
      match cStyleCastExpr(unless(isExpansionInSystemHeader())).bind("bad")
    Diagnostic:
      - BindName: bad
        Message: "C-style casts are forbidden; use a checked conversion or an appropriate named cast."
        Level: Warning
